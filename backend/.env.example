# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (read by database.py via config.py).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
# Local dev example:
DATABASE_URL=postgresql+psycopg://ecomm_user:ecomm_pass@localhost:5432/ecommerce_db
# Supabase / Railway example (use the connection string from your provider dashboard):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Secret key used to sign JWT access tokens. Generate a real random value for production,
# e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flat tax rate applied at checkout (e.g. 0.08 = 8%)
TAX_RATE=0.08
